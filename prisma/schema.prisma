model AssociationInfo {
  id                  Int      @id @default(1)
  name                String   @default("جمعية النعمة")
  address             String?
  city                String   @default("مكناس")
  phone               String?
  email               String?
  facebookUrl         String?  @map("facebook_url")
  cndpRegistration    String?  @map("cndp_registration")
  dataRetentionPolicy String?  @map("data_retention_policy")
  privacyNotice       String?  @map("privacy_notice")
  logoUrl             String?  @map("logo_url")
  // Per-RegistrationType fees, JSON map e.g. { "TAMM": 100, "DAAM_MADRASSI": 50, ... }
  registrationFees    Json?    @map("registration_fees")
  // Default UI language for this association's space ("ar" | "fr").
  defaultLocale       String   @default("ar") @map("default_locale")
  // CNSS employer code (8 digits, zero-padded) — used by Damancom monthly
  // declaration exports. Optional; the bureau UI prompts for it once.
  cnssEmployerCode    String?  @map("cnss_employer_code")
  // ICE (Identifiant Commun de l'Entreprise) — required on most invoices
  // and on the Damancom declaration form since 2018.
  ice                 String?
  // Tax identification (Identifiant Fiscal) for IS / TVA filings.
  taxId               String?  @map("tax_id")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("association_info")
}

// ==================== PERMISSIONS ====================
//
// Granular access grants. Either userId OR memberId is set (one of them).
// SectionPermission: per-section (EDU/SOCIAL/QURAN) READ/RW/ADMIN.
// BureauPermission:  global maktab READ or RW. RW lockout-protected at app layer.
// BAHT_IJTIMA3I_TEAM is modeled as a Role (see Role enum).

model SectionPermission {
  id        String          @id @default(cuid())
  userId    String?         @map("user_id")
  memberId  String?         @map("member_id")
  section   Section
  level     PermissionLevel
  grantedBy String?         @map("granted_by")
  grantedAt DateTime        @default(now()) @map("granted_at")

  user    User?   @relation("UserSectionPerms", fields: [userId], references: [id], onDelete: Cascade)
  member  Member? @relation("MemberSectionPerms", fields: [memberId], references: [id], onDelete: Cascade)
  granter User?   @relation("SectionPermGranter", fields: [grantedBy], references: [id])

  @@unique([userId, section])
  @@unique([memberId, section])
  @@index([section, level])
  @@map("section_permissions")
}

model BureauPermission {
  id        String      @id @default(cuid())
  userId    String?     @map("user_id")
  memberId  String?     @map("member_id")
  level     BureauLevel
  grantedBy String?     @map("granted_by")
  grantedAt DateTime    @default(now()) @map("granted_at")

  user    User?   @relation("UserBureauPerms", fields: [userId], references: [id], onDelete: Cascade)
  member  Member? @relation("MemberBureauPerms", fields: [memberId], references: [id], onDelete: Cascade)
  granter User?   @relation("BureauPermGranter", fields: [grantedBy], references: [id])

  @@unique([userId])
  @@unique([memberId])
  @@index([level])
  @@map("bureau_permissions")
}

// ==================== ACADEMIC YEAR ====================

model AcademicYear {
