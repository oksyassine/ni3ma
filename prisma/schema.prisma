generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  BUREAU
  FINANCIAL
  EDUCATIONAL
  SOCIAL
  QURAN
  MEMBER
  BAHT_IJTIMA3I_TEAM // Field-research team — privileged read on full beneficiary records
}

enum PermissionLevel {
  READ
  RW
  ADMIN
}

enum BureauLevel {
  READ
  RW
}

enum RegistrationType {
  TAMM // التسجيل التام
  DAAM_MADRASSI // الدعم المدرسي
  QURAN_TAJWEED // دروس الحفظ والتجويد
  MOKHAYAM // المخيم
}

enum HealthStatus {
  HEALTHY
  SICK
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BeneficiaryType {
  GENERAL
  YATIM
  MOZWIZ
}

enum MemberType {
  CHILD
  ADULT
}

enum Gender {
  MALE
  FEMALE
}

enum Section {
  EDUCATIONAL
  SOCIAL
  QURAN
  QUDAT          // مركز تأهيل القضاة
  MEDIA          // قسم الإعلامي
}

enum ExpenseCategory {
  EDUCATIONAL
  SOCIAL
  QURAN
  ADMINISTRATIVE
  MAINTENANCE
  OTHER
}

enum ProjectStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum HifzGrade {
  EXCELLENT
  GOOD
  AVERAGE
  NEEDS_WORK
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  PUBLISH // publish of an election minute, donor story, etc.
  SKIP    // an operation that was intentionally not performed
}

enum ProjectKind {
  NACHAT // نشاط — one-off activity/event
  MACHROO3 // مشروع — ongoing initiative
}

enum DonationKind {
  CASH // نقدي
  IN_KIND // عيني
  ZAKAT_FITRA // زكاة الفطر
  ZAKAT_MAL // زكاة المال
  SADAQA // صدقة
  WAQF // وقف
  KAFFARA // كفارة
}

// The 8 categories (asnaf) of Zakat recipients, per Quran 9:60.
enum ZakatAsnaaf {
  FAQIR // الفقراء
  MISKEEN // المساكين
  AMIL // العاملون عليها
  MUALLAFATUL_QULOOB // المؤلفة قلوبهم
  FIR_RIQAB // في الرقاب
  AL_GHARIMIN // الغارمون
  FI_SABILILLAH // في سبيل الله
  IBN_AL_SABIL // ابن السبيل
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

enum RiskStatus {
  OPEN
  MITIGATED
  OCCURRED
  CLOSED
}

// Governance & compliance pack — Moroccan association law (Dahir 1-58-376 as
// amended by lois 75-00 / 07-09) requires: general assemblies with signed PVs,
// bureau-change declarations, and justification of public subsidies (>10k MAD)
// to funders. The models below digitize that lifecycle.

enum MeetingKind {
  AGO    // الجمع العام العادي
  AGE    // الجمع العام غير العادي
  BUREAU // جلسة المكتب الإداري
  OTHER
}

enum GrantFunderKind {
  INDH          // المبادرة الوطنية للتنمية البشرية
  COMMUNE       // جماعة ترابية
  MINISTRY      // وزارة / مؤسسة عمومية
  INTERNATIONAL // تعاون دولي (الاتحاد الأوروبي، الوكالات...)
  FOUNDATION    // مؤسسة خاصة
  OTHER
}

enum GrantStatus {
  APPLIED   // ملف مقدم قيد الدراسة
  APPROVED  // مصادق عليها (لم تُوقّع الاتفاقية)
  ACTIVE    // اتفاقية موقعة — جاري التنفيذ
  COMPLETED // أنجزت وتم تقديم الحصيلة
  CANCELLED
}

enum AssetCondition {
  GOOD
  NEEDS_REPAIR
  OUT_OF_SERVICE
}

enum SponsorshipKind {
  YATIM   // كفالة يتيم
  STUDENT // كفالة طالب علم
  FAMILY  // رعاية أسرة معوزة
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum OfficialDocKind {
  STATUTES     // القانون الأساسي
  INTERNAL_RULES // النظام الداخلي
  PV           // محضر
  DECLARATION  // تصريح إيداع / تعديل
  BANK         // وثيقة بنكية
  CNSS         // تصريح CNSS
  AGREEMENT    // اتفاقية شراكة
  INSURANCE    // تأمين
  RECEIPT      // وصل جمعياتي (الجريدة الرسمية)
  OTHER
}

enum DistributionKind {
  RAMADAN_BASKET // قفة رمضان
  IFTAR          // إفطار الصائم / موائد الرحمن
  ADHI           // الهدي والأضاحي
  EID_CLOTHES    // كسوة العيد والشتاء
  FOOD_BASKET    // سلة غذائية عادية
  SCHOOL_KIT     // حقيبة مدرسية
  OTHER
}

// Cross-cutting digitalization pack — records every Moroccan association is
// expected to keep (correspondence register, branches, trainings) plus the
// written volunteer contracts made mandatory by law 06-18 (Aug 2021).

enum MailDirection {
  INCOMING // وارد
  OUTGOING // صادر
}

enum MailStatus {
  PENDING   // قيد المعالجة
  PROCESSED // تمت المعالجة
  ARCHIVED
}

enum CourseStatus {
  PLANNED
  ONGOING
  DONE
  CANCELLED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  ENDED
  TERMINATED
}

// Staff/employee management — associations that employ anyone must run
// payroll + CNSS monthly and keep signed contracts on file.
enum EmployeeContractType {
  CDI          // عقد دائم
  CDD          // عقد محدد المدة
  APPRENTICESHIP // تكوين بالتناوب
  STAGE        // تدريب
  ANAPEC       // عقد أنابيك / إدماج
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum PayrollStatus {
  PENDING
  PAID
  CNSS_DECLARED
}

// Non-financial partnership agreements (different from Grants which track
// money): schools, clinics, communes, peer NGOs, corporate CSR partners.
enum PartnershipKind {
  PUBLIC_INSTITUTION // جماعة، وزارة، مؤسسة عمومية
  PRIVATE_COMPANY
  NGO
  SCHOOL             // مؤسسات تعليمية
  HEALTH             // مصحة، مستشفى
  INTERNATIONAL
  OTHER
}

enum PartnershipStatus {
  DRAFT
  SIGNED
  ACTIVE
  EXPIRED
  TERMINATED
}

// Library catalog — quran schools, cultural and literacy associations all
// lend books; copies are tracked separately from holdings.
enum BookCategory {
  QURAN
  TAFSIR
  HADITH
  FIQH
  AQIDA
  ARABIC_LANGUAGE
  GENERAL
  CHILDREN
  OTHER
}

enum BorrowingStatus {
  OPEN
  RETURNED
  LATE
  LOST
}

// ==================== AUTH ====================

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  email        String?
  phone        String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles                   UserRole[]
  recordedContributions   WeeklyContribution[] @relation("RecordedBy")
  recordedExpenses        Expense[]            @relation("RecordedBy")
  approvedExpenses        Expense[]            @relation("ApprovedBy")
  recordedDonations       Donation[]           @relation("RecordedBy")
  signedDonationReceipts  Donation[]           @relation("DonationSigner")
  signedBeneficiaryReceipts BeneficiaryReceipt[] @relation("BeneficiaryReceiptSigner")
  closedInventoryRegisters InventoryRegister[] @relation("InventoryCloser")
  memberNotes             MemberNote[]
  electionsCreated        Election[]           @relation("ElectionCreator")
  electionMinutesSigned   ElectionMinute[]     @relation("ElectionMinuteSigner")
  eventsCreated           Event[]              @relation("EventCreator")
  ticketsCheckedIn        Ticket[]             @relation("TicketChecker")
  createdPrograms         AnnualProgram[]
  uploadedResources       SectionResource[]
  recordedAttendance      Attendance[]
  recordedQuranProgress   QuranProgress[]      @relation("QuranRecorder")
  approvedVolunteerHours  VolunteerHours[]     @relation("VolunteerApprover")
  auditLogs               AuditLog[]
  recordedInKindDonations InKindDonation[]     @relation("InKindRecorder")
  createdProjects         SocialProject[]      @relation("ProjectCreator")
  evaluatedProjects       SocialProject[]      @relation("ProjectEvaluator")
  createdTasks            ProjectTask[]        @relation("TaskCreator")
  sectionPermissions      SectionPermission[]  @relation("UserSectionPerms")
  bureauPermissions       BureauPermission[]   @relation("UserBureauPerms")
  grantedSectionPerms     SectionPermission[]  @relation("SectionPermGranter")
  grantedBureauPerms      BureauPermission[]   @relation("BureauPermGranter")

  @@map("users")
}

model UserRole {
  id     String @id @default(cuid())
  userId String @map("user_id")
  role   Role

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

// ==================== MEMBERS ====================

model Member {
  id                 String            @id @default(cuid())
  registrationNumber Int               @unique @default(autoincrement()) @map("registration_number")
  memberType         MemberType        @map("member_type")
  photoUrl           String?           @map("photo_url")
  fullName           String            @map("full_name")
  dateOfBirth        DateTime?         @map("date_of_birth") @db.Date
  placeOfBirth       String?           @map("place_of_birth")
  gender             Gender?
  cin                String? // For adults
  parentCin          String?           @map("parent_cin") // For children — kept for compatibility
  // FATHER (children)
  fatherName         String?           @map("father_name")
  fatherPhone        String?           @map("father_phone")
  fatherCin          String?           @map("father_cin")
  fatherProfession   String?           @map("father_profession")
  fatherEducation    String?           @map("father_education")
  fatherLandline     String?           @map("father_landline")
  fatherAddress      String?           @map("father_address")
  // MOTHER (children)
  motherName         String?           @map("mother_name")
  motherPhone        String?           @map("mother_phone")
  motherCin          String?           @map("mother_cin")
  motherProfession   String?           @map("mother_profession")
  motherEducation    String?           @map("mother_education")
  motherLandline     String?           @map("mother_landline")
  motherAddress      String?           @map("mother_address")
  siblingsCount      Int?              @map("siblings_count") // legacy — sum of boys+girls
  siblingsBoys       Int?              @map("siblings_boys")
  siblingsGirls      Int?              @map("siblings_girls")
  siblingOrder       Int?              @map("sibling_order")
  healthStatus       HealthStatus?     @map("health_status") // 3adi / marid
  healthConditions   String?           @map("health_conditions") // naw3 marad (free text)
  educationalLevel   String?           @map("educational_level")
  address            String?
   phone              String?
   landline           String? // الهاتف الثابت (adults)
   email              String? // For self-service portal + magic-link recovery
  profession         String? // For adults
  // Adult marital + children
  maritalStatus      MaritalStatus?    @map("marital_status")
  childrenBoys       Int?              @map("children_boys")
  childrenGirls      Int?              @map("children_girls")
  // Adult interests — checkboxes + free-text other
  interestJtima3iya  Boolean           @default(false) @map("interest_jtima3iya")
  interestTarbawiya  Boolean           @default(false) @map("interest_tarbawiya")
  interestFikriya    Boolean           @default(false) @map("interest_fikriya")
  interests          String? // free-text — "other" / details
  associationRole    String?           @map("association_role") // For adults
  registrationType   RegistrationType? @map("registration_type")
  registrationDate   DateTime          @default(now()) @map("registration_date") @db.Date
  subscriptionAmount Decimal?          @map("subscription_amount") @db.Decimal(10, 2)
  isActive           Boolean           @default(true) @map("is_active")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  // Auth fields — only used for adult members with login access
  username     String? @unique
  passwordHash String? @map("password_hash")
  userIsActive Boolean @default(false) @map("user_is_active")

  // Stable token used as QR badge content for attendance check-in
  checkinToken String? @unique @map("checkin_token")

  sections           MemberSection[]
  contributions      WeeklyContribution[]
  notes              MemberNote[]
  attendance         Attendance[]
  userRoles          MemberRole[]
  invitations        Invitation[]
  passwordResets     PasswordResetToken[]
  quranProgress      QuranProgress[]
  volunteerHours     VolunteerHours[]
  candidacies        Candidacy[]
  votes              Vote[]
  tickets            Ticket[]
  parentLinks        FamilyLink[]         @relation("ParentLinks")
  childLinks         FamilyLink[]         @relation("ChildLinks")
  taskAssignments    TaskAssignment[]
  taskWorklogs       TaskWorklog[]
  sectionPermissions SectionPermission[]  @relation("MemberSectionPerms")
  bureauPermissions  BureauPermission[]   @relation("MemberBureauPerms")
  mandates           BureauMandate[]
  volunteerContracts VolunteerContract[]
  borrowings         BookBorrowing[]
  messagesOut        MessageOut[]

  @@map("members")
}

// ==================== FAMILY ====================

model FamilyLink {
  id        String   @id @default(cuid())
  parentId  String   @map("parent_id")
  childId   String   @map("child_id")
  relation  String? // أب، أم، ولي
  createdAt DateTime @default(now()) @map("created_at")

  parent Member @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  child  Member @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@map("family_links")
}

model Invitation {
  id        String    @id @default(cuid())
  memberId  String    @map("member_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

model MemberRole {
  id       String @id @default(cuid())
  memberId String @map("member_id")
  role     Role

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, role])
  @@map("member_roles")
}

model MemberSection {
  id         String   @id @default(cuid())
  memberId   String   @map("member_id")
  section    Section
  enrolledAt DateTime @default(now()) @map("enrolled_at") @db.Date
  isActive   Boolean  @default(true) @map("is_active")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, section])
  @@map("member_sections")
}

// ==================== FINANCIAL ====================

model WeeklyContribution {
  id             String   @id @default(cuid())
  memberId       String   @map("member_id")
  amount         Decimal  @db.Decimal(10, 2)
  weekStart      DateTime @map("week_start") @db.Date
  paidAt         DateTime @default(now()) @map("paid_at")
  recordedBy     String?  @map("recorded_by")
  notes          String?
  academicYearId String?  @map("academic_year_id")
  // Quittance (quittance de cotisation) — auto-numbered on first print.
  quittanceNumber    String? @unique @map("quittance_number")
  quittanceIssuedAt  DateTime? @map("quittance_issued_at") @db.Date

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recorder     User?         @relation("RecordedBy", fields: [recordedBy], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([memberId, weekStart])
  @@index([quittanceNumber])
  @@map("weekly_contributions")
}

model Expense {
  id             String          @id @default(cuid())
  category       ExpenseCategory
  section        Section?
  description    String
  amount         Decimal         @db.Decimal(10, 2)
  expenseDate    DateTime        @map("expense_date") @db.Date
  receiptUrl     String?         @map("receipt_url")
  recordedBy     String?         @map("recorded_by")
  approvedBy     String?         @map("approved_by")
  academicYearId String?         @map("academic_year_id")
  // Project budget linkage (all optional)
  projectId      String?         @map("project_id")
  planId         String?         @map("plan_id")
  planLineItemId String?         @map("plan_line_item_id")
  createdAt      DateTime        @default(now()) @map("created_at")

  recorder     User?          @relation("RecordedBy", fields: [recordedBy], references: [id])
  approver     User?          @relation("ApprovedBy", fields: [approvedBy], references: [id])
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])
  project      SocialProject? @relation("ProjectExpenses", fields: [projectId], references: [id], onDelete: SetNull)
  plan         ProjectPlan?   @relation("PlanExpenses", fields: [planId], references: [id], onDelete: SetNull)
  planLineItem PlanLineItem?  @relation("PlanLineItemExpenses", fields: [planLineItemId], references: [id], onDelete: SetNull)

  @@map("expenses")
}

model Donation {
  id             String    @id @default(cuid())
  donorName      String?   @map("donor_name")
  donorPhone     String?   @map("donor_phone")
  donorCin       String?   @map("donor_cin")
  donorAddress   String?   @map("donor_address")
  donorEmail     String?   @map("donor_email")
  amount         Decimal   @db.Decimal(10, 2)
  section        Section   @default(SOCIAL)
  projectId      String?  @map("project_id")
  campaignId     String?  @map("campaign_id")
  donationDate   DateTime  @default(now()) @map("donation_date") @db.Date
  isAnonymous    Boolean   @default(false) @map("is_anonymous")
  // Pledged donation flow (committed but not yet paid)
  isPaid         Boolean   @default(true) @map("is_paid")
  pledgedAt      DateTime? @map("pledged_at")
  paidAt         DateTime? @map("paid_at")
  notes          String?
  recordedBy     String?  @map("recorded_by")
  academicYearId String?  @map("academic_year_id")
  // Zakat-specific classification (Quran 9:60 — 8 asnaf of recipients).
  // Only meaningful when kind ∈ {ZAKAT_FITRA, ZAKAT_MAL}. Optional for
  // SADAQA / WAQF (the donor may earmark an asnaf but it's not mandatory).
  asnaaf         ZakatAsnaaf?
  // "Waqf" donations are intended to be locked indefinitely. We record the
  // endowment deed number here when the donor provides one.
  waqfDeedNumber String?   @map("waqf_deed_number")
  kind           DonationKind @default(CASH)
  createdAt      DateTime    @default(now()) @map("created_at")
  // Receipt (reçu fiscal) — auto-numbered on first generation per
  // (tenant, year). Art. 6 CGI allows donors to deduct up to 2‰ of CAHT.
  receiptNumber    String?   @unique @map("receipt_number")
  receiptIssuedAt DateTime? @map("receipt_issued_at") @db.Date
  receiptSignedBy  String?   @map("receipt_signed_by")

  project      SocialProject? @relation(fields: [projectId], references: [id])
  campaign     DonationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  recorder     User?          @relation("RecordedBy", fields: [recordedBy], references: [id])
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])
  signer       User?          @relation("DonationSigner", fields: [receiptSignedBy], references: [id], onDelete: SetNull)

  @@index([donationDate])
  @@index([receiptNumber])
  @@map("donations")
}

model SocialProject {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String?       @unique
  isPublic              Boolean       @default(false) @map("is_public")
  coverPhotoUrl         String?       @map("cover_photo_url")
  recurringFromId       String?       @map("recurring_from_id")
  kind                  ProjectKind   @default(MACHROO3)
  description           String?
  // البطاقة التقنية fields
  objective             String? // الهدف
  targetAudience        String?       @map("target_audience") // الفئة المستهدفة
  expectedBeneficiaries Int?          @map("expected_beneficiaries")
  location              String?
  partners              String? // الشركاء
  // Financials & timeline
  targetAmount          Decimal?      @map("target_amount") @db.Decimal(10, 2)
  startDate             DateTime?     @map("start_date") @db.Date
  endDate               DateTime?     @map("end_date") @db.Date
  status                ProjectStatus @default(ACTIVE)
  section               Section       @default(SOCIAL)
  academicYearId        String?       @map("academic_year_id")
  createdBy             String?       @map("created_by")
  // Evaluation (filled at project completion)
  evaluationReport      String?       @map("evaluation_report")
  evaluationScore       Int?          @map("evaluation_score") // 1-5
  evaluationLessons     String?       @map("evaluation_lessons") // الدروس المستفادة
  evaluationRecommend   String?       @map("evaluation_recommend") // التوصيات
  actualBeneficiaries   Int?          @map("actual_beneficiaries")
  evaluatedAt           DateTime?     @map("evaluated_at")
  evaluatedBy           String?       @map("evaluated_by")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  donations          Donation[]
  inKindDonations    InKindDonation[]
  grants             Grant[]              @relation("GrantProject")
  campaigns          DonationCampaign[]
  plans              ProjectPlan[]
  tasks              ProjectTask[]
  expenses           Expense[]            @relation("ProjectExpenses")
  photos             ProjectPhoto[]
  beneficiaries      ProjectBeneficiary[]
  risks              ProjectRisk[]
  stakeholders       ProjectStakeholder[]
  academicYear       AcademicYear?        @relation(fields: [academicYearId], references: [id])
  creator            User?                @relation("ProjectCreator", fields: [createdBy], references: [id])
  evaluator          User?                @relation("ProjectEvaluator", fields: [evaluatedBy], references: [id])
  recurringFrom      SocialProject?       @relation("RecurringInstances", fields: [recurringFromId], references: [id], onDelete: SetNull)
  recurringInstances SocialProject[]      @relation("RecurringInstances")

  @@map("social_projects")
}

model InKindDonation {
  id             String   @id @default(cuid())
  projectId      String?  @map("project_id")
  donorName      String?  @map("donor_name")
  donorPhone     String?  @map("donor_phone")
  itemName       String   @map("item_name")
  quantity       Decimal  @db.Decimal(10, 2)
  unit           String? // كجم، علبة، قطعة...
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(10, 2)
  donationDate   DateTime @default(now()) @map("donation_date") @db.Date
  isAnonymous    Boolean  @default(false) @map("is_anonymous")
  notes          String?
  recordedBy     String?  @map("recorded_by")
  academicYearId String?  @map("academic_year_id")
  createdAt      DateTime @default(now()) @map("created_at")

  project      SocialProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  recorder     User?          @relation("InKindRecorder", fields: [recordedBy], references: [id])
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])

  @@map("in_kind_donations")
}

model ProjectPlan {
  id            String   @id @default(cuid())
  projectId     String   @map("project_id")
  name          String
  description   String?
  estimatedCost Decimal? @map("estimated_cost") @db.Decimal(10, 2)
  isActive      Boolean  @default(false) @map("is_active") // The selected plan
  position      Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")

  project   SocialProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineItems PlanLineItem[]
  expenses  Expense[]      @relation("PlanExpenses")
  taskPlans TaskPlan[]

  @@map("project_plans")
}

model PlanLineItem {
  id        String   @id @default(cuid())
  planId    String   @map("plan_id")
  name      String
  amount    Decimal  @db.Decimal(10, 2)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  plan     ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  expenses Expense[]   @relation("PlanLineItemExpenses")

  @@map("plan_line_items")
}

model ProjectTask {
  id               String       @id @default(cuid())
  projectId        String       @map("project_id")
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?    @map("due_date") @db.Date
  estimatedHours   Decimal?     @map("estimated_hours") @db.Decimal(6, 2)
  // Task-level budget: planned (assigner's estimate) + actual (entered by assignee at completion)
  plannedExpense   Decimal?     @map("planned_expense") @db.Decimal(10, 2)
  actualExpense    Decimal?     @map("actual_expense") @db.Decimal(10, 2)
  position         Int          @default(0)
  parentTaskId     String?      @map("parent_task_id")
  createdBy        String?      @map("created_by")
  completedAt      DateTime?    @map("completed_at")
  // Allow SECTION_READ users to self-claim. Default off to prevent task hijacking.
  openForSelfClaim Boolean      @default(false) @map("open_for_self_claim")
  // When true, surfaces in the Media section's cross-project Kanban (poster,
  // social-media story, etc.). Same row — status sync is automatic.
  needsMedia       Boolean      @default(false) @map("needs_media")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  project   SocialProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    ProjectTask?     @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks  ProjectTask[]    @relation("Subtasks")
  assignees TaskAssignment[]
  worklogs  TaskWorklog[]
  taskPlans TaskPlan[]
  creator   User?            @relation("TaskCreator", fields: [createdBy], references: [id])

  @@index([projectId, status])
  @@map("project_tasks")
}

model TaskPlan {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  planId    String   @map("plan_id")
  createdAt DateTime @default(now()) @map("created_at")

  task ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  plan ProjectPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([taskId, planId])
  @@map("task_plans")
}

model TaskAssignment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  memberId  String   @map("member_id")
  createdAt DateTime @default(now()) @map("created_at")

  task   ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

