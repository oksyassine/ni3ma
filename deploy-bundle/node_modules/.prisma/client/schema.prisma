  @@map("association_info")
}

// ==================== PERMISSIONS ====================
//
// Granular access grants. Either userId OR memberId is set (one of them).
// SectionPermission: per-section (EDU/SOCIAL/QURAN) READ/RW/ADMIN.
// BureauPermission:  global maktab READ or RW. RW lockout-protected at app layer.
// BAHT_IJTIMA3I_TEAM is modeled as a Role (see Role enum).

model SectionPermission {
  id        String          @id @default(cuid())
  userId    String?         @map("user_id")
  memberId  String?         @map("member_id")
  section   Section
  level     PermissionLevel
  grantedBy String?         @map("granted_by")
  grantedAt DateTime        @default(now()) @map("granted_at")

  user    User?   @relation("UserSectionPerms", fields: [userId], references: [id], onDelete: Cascade)
  member  Member? @relation("MemberSectionPerms", fields: [memberId], references: [id], onDelete: Cascade)
  granter User?   @relation("SectionPermGranter", fields: [grantedBy], references: [id])

  @@unique([userId, section])
  @@unique([memberId, section])
  @@index([section, level])
  @@map("section_permissions")
}

model BureauPermission {
  id        String      @id @default(cuid())
  userId    String?     @map("user_id")
  memberId  String?     @map("member_id")
  level     BureauLevel
  grantedBy String?     @map("granted_by")
  grantedAt DateTime    @default(now()) @map("granted_at")

  user    User?   @relation("UserBureauPerms", fields: [userId], references: [id], onDelete: Cascade)
  member  Member? @relation("MemberBureauPerms", fields: [memberId], references: [id], onDelete: Cascade)
  granter User?   @relation("BureauPermGranter", fields: [grantedBy], references: [id])

  @@unique([userId])
  @@unique([memberId])
  @@index([level])
  @@map("bureau_permissions")
}

// ==================== ACADEMIC YEAR ====================

model AcademicYear {
  id        String   @id @default(cuid())
  label     String   @unique // e.g., "2025-2026"
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")

  contributions   WeeklyContribution[]
  expenses        Expense[]
  donations       Donation[]
  attendance      Attendance[]
  programs        AnnualProgram[]
  quranProgress   QuranProgress[]
  volunteerHours  VolunteerHours[]
  socialProjects  SocialProject[]
  inKindDonations InKindDonation[]

  @@map("academic_years")
}

// ==================== MULTI-TENANCY (control plane) ====================
//
// DB-per-tenant architecture. This registry lives in the PRIMARY database
// (DATABASE_URL); each association gets its own isolated database whose URL
// is derived from TENANT_DB_URL_TEMPLATE. The primary DB also serves as the
// default/fallback for requests that arrive without a tenant host (apex
// marketing site, local dev) — which is why legacy Ni3ma data lives there.

enum TenantStatus {
  PENDING_PROVISIONING
  ACTIVE
  SUSPENDED
  PROVISION_FAILED
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  CUSTOM
}

model Tenant {
  id                 String       @id @default(cuid())
  name               String // association display name (Arabic)
  slug               String       @unique // subdomain label, [a-z0-9-]
  city               String?
  plan               TenantPlan   @default(FREE)
  status             TenantStatus @default(PENDING_PROVISIONING)
  dbUrl              String       @unique @map("db_url")
  customDomain       String?      @unique @map("custom_domain") // future: CNAME mappings
  contactName        String?      @map("contact_name")
  contactPhone       String?      @map("contact_phone")
  contactEmail       String?      @map("contact_email")
  trialEndsAt        DateTime?    @map("trial_ends_at")
  provisionedAt      DateTime?    @map("provisioned_at")
  lastProvisionError String?      @map("last_provision_error")
  // Paid subscription window (null while on free/trial)
  currentPeriodEnd   DateTime?    @map("current_period_end")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  payments TenantPayment[]

  @@index([status])
  @@map("tenants")
}

enum TenantPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

// Subscription invoices created before redirecting the payer to YouCan Pay.
// Lives in the PLATFORM database only (like Tenant).
model TenantPayment {
  id            String              @id @default(cuid())
  tenantId      String              @map("tenant_id")
  plan          TenantPlan
  amount        Decimal             @db.Decimal(10, 2)
  currency      String              @default("MAD")
  months        Int                 @default(1)
  provider      String              @default("youcanpay")
  // Our unique reference sent as order_id to the gateway; echoed back in webhooks.
  orderId       String              @unique @map("order_id")
  tokenId       String?             @map("token_id")
  transactionId String?             @map("transaction_id")
  status        TenantPaymentStatus @default(PENDING)
  periodStart   DateTime?           @map("period_start")
  periodEnd     DateTime?           @map("period_end")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("tenant_payments")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?     @map("user_id")
  action    AuditAction
  entity    String // e.g., "member", "contribution"
  entityId  String?     @map("entity_id")
  before    Json?
  after     Json?
  ip        String?
  userAgent String?     @map("user_agent")
  createdAt DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==================== QURAN PROGRESS ====================

model QuranProgress {
  id                     String     @id @default(cuid())
  memberId               String     @map("member_id")
  recitationDate         DateTime   @map("recitation_date") @db.Date
  currentSurah           String?    @map("current_surah")
  surahFromAyah          Int?       @map("surah_from_ayah")
  surahToAyah            Int?       @map("surah_to_ayah")
  hizb                   Int?
  juz                    Int?
  pagesMemorized         Int?       @map("pages_memorized")
  hifzGrade              HifzGrade? @map("hifz_grade")
  // Tajweed rubric (1-5 scale each) — full classical قواعد
  tajweedMakharij        Int?       @map("tajweed_makharij") // مخارج الحروف
  tajweedSifaat          Int?       @map("tajweed_sifaat") // صفات الحروف
  tajweedNoonMeem        Int?       @map("tajweed_noon_meem") // أحكام النون الساكنة والتنوين
  tajweedMeemSakinah     Int?       @map("tajweed_meem_sakinah") // أحكام الميم الساكنة
  tajweedMudood          Int?       @map("tajweed_mudood") // أحكام المدود
  tajweedLamTareef       Int?       @map("tajweed_lam_tareef") // أحكام لام التعريف
  tajweedQalqala         Int?       @map("tajweed_qalqala") // القلقلة
  tajweedTarqeeqTafkheem Int?       @map("tajweed_tarqeeq_tafkheem") // الترقيق والتفخيم
  tajweedRaa             Int?       @map("tajweed_raa") // أحكام الراء
  tajweedWaqf            Int?       @map("tajweed_waqf") // الوقف والابتداء
  tajweedImalah          Int?       @map("tajweed_imalah") // الإمالة والتسهيل
  tajweedFluency         Int?       @map("tajweed_fluency") // طلاقة التلاوة
  tajweedOverall         Int?       @map("tajweed_overall") // التقييم العام
  notes                  String?
  recordedBy             String?    @map("recorded_by")
  academicYearId         String?    @map("academic_year_id")
  createdAt              DateTime   @default(now()) @map("created_at")

  member       Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recorder     User?         @relation("QuranRecorder", fields: [recordedBy], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@index([memberId, recitationDate])
  @@map("quran_progress")
}

