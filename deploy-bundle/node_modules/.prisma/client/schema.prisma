// ==================== ASSOCIATION INFO ====================

model AssociationInfo {
  id                  Int      @id @default(1)
  name                String   @default("جمعية النعمة")
  address             String?
  city                String   @default("مكناس")
  phone               String?
  email               String?
  facebookUrl         String?  @map("facebook_url")
  cndpRegistration    String?  @map("cndp_registration")
  dataRetentionPolicy String?  @map("data_retention_policy")
  privacyNotice       String?  @map("privacy_notice")
  logoUrl             String?  @map("logo_url")
  // Per-RegistrationType fees, JSON map e.g. { "TAMM": 100, "DAAM_MADRASSI": 50, ... }
  registrationFees    Json?    @map("registration_fees")
  // Default UI language for this association's space ("ar" | "fr").
  defaultLocale       String   @default("ar") @map("default_locale")
