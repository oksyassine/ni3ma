// ==================== GOVERNANCE & COMPLIANCE ====================

model Meeting {
  id                String      @id @default(cuid())
  kind              MeetingKind @default(AGO)
  title             String
  heldAt            DateTime    @map("held_at") @db.Date
  location          String?
  convocationMethod String?     @map("convocation_method") // واتساب، هاتف، بريد...
  agenda            String? // جدول الأعمال
  minutes           String? // نص المحضر (PV)
  minutesUrl        String?     @map("minutes_url") // نسخة ممسوحة ضوئيا موقعة
  expectedCount     Int         @default(0) @map("expected_count")
  presentCount      Int         @default(0) @map("present_count")
  quorumPct         Int         @default(50) @map("quorum_pct") // حسب القانون الأساسي
  createdAt         DateTime    @default(now()) @map("created_at")

  decisions MeetingDecision[]

  @@index([heldAt])
  @@map("meetings")
}

model MeetingDecision {
  id           String   @id @default(cuid())
  meetingId    String   @map("meeting_id")
  title        String
  body         String?
  votesFor     Int      @default(0) @map("votes_for")
  votesAgainst Int      @default(0) @map("votes_against")
  votesAbstain Int      @default(0) @map("votes_abstain")
  passed       Boolean  @default(true)
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_decisions")
}

model Grant {
  id           String          @id @default(cuid())
  funderName   String          @map("funder_name")
  funderKind   GrantFunderKind @default(OTHER) @map("funder_kind")
  projectName  String          @map("project_name")
  reference    String? // رقم الاتفاقية
  amount       Decimal         @db.Decimal(10, 2)
  status       GrantStatus     @default(APPLIED)
  signedAt     DateTime?       @map("signed_at") @db.Date
  startDate    DateTime?       @map("start_date") @db.Date
  endDate      DateTime?       @map("end_date") @db.Date
  projectId    String?         @map("project_id")
  contactName  String?         @map("contact_name")
  contactPhone String?         @map("contact_phone")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  project  SocialProject? @relation("GrantProject", fields: [projectId], references: [id], onDelete: SetNull)
  tranches GrantTranche[]

  @@index([status])
  @@index([endDate])
  @@map("grants")
}

model GrantTranche {
  id          String    @id @default(cuid())
  grantId     String    @map("grant_id")
  label       String    @default("شطر")
  amount      Decimal   @db.Decimal(10, 2)
  expectedAt  DateTime? @map("expected_at") @db.Date
  receivedAt  DateTime? @map("received_at") @db.Date
  reportDueAt DateTime? @map("report_due_at") @db.Date
  reportedAt  DateTime? @map("reported_at") @db.Date
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")

  grant Grant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@map("grant_tranches")
}

model Asset {
  id           String         @id @default(cuid())
  name         String
  category     String? // أثاث، عتاد معلوماتي، وسائل بيداغوجية، عقار، نقل...
  quantity     Int            @default(1)
  value        Decimal?       @db.Decimal(10, 2)
  serialNumber String?        @map("serial_number")
  location     String?
  condition    AssetCondition @default(GOOD)
  acquiredAt   DateTime?      @map("acquired_at") @db.Date
  source       String? // شراء، تبرع، منحة
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([category])
  @@map("assets")
}

model Sponsorship {
  id              String            @id @default(cuid())
  kind            SponsorshipKind   @default(YATIM)
  beneficiaryName String            @map("beneficiary_name")
  socialCaseId    String?           @map("social_case_id")
  sponsorName     String            @map("sponsor_name")
  sponsorPhone    String?           @map("sponsor_phone")
  monthlyAmount   Decimal           @map("monthly_amount") @db.Decimal(10, 2)
  dayOfMonth      Int               @default(5) @map("day_of_month") // يوم التسليم الشهري (1-28)
  startedAt       DateTime          @map("started_at") @db.Date
  endedAt         DateTime?         @map("ended_at") @db.Date
  status          SponsorshipStatus @default(ACTIVE)
  notes           String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  socialCase SocialCase? @relation(fields: [socialCaseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("sponsorships")
}

// Registry of statutory/critical documents with expiry alerts. Moroccan
// bureaus juggle statutes, official-gazette receipts, bank/CNSS papers and
// partnership agreements — losing track of these blocks subsidy files.
model OfficialDocument {
  id           String          @id @default(cuid())
  kind         OfficialDocKind @default(OTHER)
  title        String
  reference    String?
  issuedAt     DateTime?       @map("issued_at") @db.Date
  expiresAt    DateTime?       @map("expires_at") @db.Date // null = دائمة الصلاحية
  reminderDays Int             @default(30) @map("reminder_days")
  fileUrl      String?         @map("file_url")
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("official_documents")
}

// Bureau composition with mandate windows. Art. 5 of the Dahir (as amended by
// loi 07-09) requires declaring bureau changes to the local authority within
// ONE MONTH — declaredAt tracks that filing.
model BureauMandate {
  id            String    @id @default(cuid())
  memberId      String?   @map("member_id")
  memberName    String    @map("member_name")
  position      String // الرئيس، نائب الرئيس، الكاتب العام...
  positionOrder Int       @default(99) @map("position_order") // sort key for the org chart
  startedAt     DateTime  @map("started_at") @db.Date
  endedAt       DateTime? @map("ended_at") @db.Date
  declaredAt    DateTime? @map("declared_at") @db.Date // تاريخ إيداع التصريح
  isActive      Boolean   @default(true) @map("is_active")
  notes         String?

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@map("bureau_mandates")
}

// Seasonal distribution campaigns (Ramadan baskets, iftar, adhi...). Entries
// log delivered units per beneficiary for funder-facing reports.
model DistributionCampaign {
  id           String           @id @default(cuid())
  kind         DistributionKind @default(OTHER)
  name         String
  yearLabel    String?          @map("year_label") // e.g., "1447هـ / 2026"
  unitLabel    String?          @map("unit_label") // سلة، وجبة، ثوب...
  plannedUnits Int              @default(0) @map("planned_units")
  budget       Decimal?         @db.Decimal(10, 2)
  startDate    DateTime?        @map("start_date") @db.Date
  endDate      DateTime?        @map("end_date") @db.Date
  notes        String?
  createdAt    DateTime         @default(now()) @map("created_at")

  entries DistributionEntry[]

  @@index([kind])
  @@map("distribution_campaigns")
}

model DistributionEntry {
  id              String   @id @default(cuid())
  campaignId      String   @map("campaign_id")
  beneficiaryName String   @map("beneficiary_name")
  socialCaseId    String?  @map("social_case_id")
  quantity        Int      @default(1)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  campaign   DistributionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  socialCase SocialCase?          @relation(fields: [socialCaseId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@map("distribution_entries")
}

// سجل المراسلات — the serial-numbered incoming/outgoing mail register every
// bureau keeps when dealing with authorities, funders and partners.
model MailItem {
  id            String        @id @default(cuid())
  direction     MailDirection @default(INCOMING)
  reference     String // e.g., "و/2026/012" or "ص/2026/008"
  subject       String
  correspondent String // الجهة المرسلة أو المرسل إليها
  mailDate      DateTime      @map("mail_date") @db.Date
  channel       String? // عادي، مُوصى عليه، إلكتروني، يد بيد...
  status        MailStatus    @default(PENDING)
  responseDueAt DateTime?     @map("response_due_at") @db.Date
  respondedAt   DateTime?     @map("responded_at") @db.Date
  fileUrl       String?       @map("file_url")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([direction, status])
  @@index([mailDate])
  @@map("mail_items")
}

// Branch / antenna registry for federations, multi-site associations and
// parents'-association chapters (one per school institution).
model Branch {
  id              String    @id @default(cuid())
  name            String
  city            String?
  address         String?
  phone           String?
  email           String?
  responsibleName String?   @map("responsible_name")
  openedAt        DateTime? @map("opened_at") @db.Date
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([isActive])
  @@map("branches")
}

// Capacity-building courses (literacy, vocational, administrative training) —
// heavily funded by INDH/ministry programs; participants tracked per course.
model TrainingCourse {
  id          String       @id @default(cuid())
  title       String
  field       String? // محو الأمية، تكوين إداري، مهن...
  trainerName String?      @map("trainer_name")
  partner     String? // الشريك / الممول
  location    String?
  seatsTotal  Int          @default(0) @map("seats_total")
  startDate   DateTime?    @map("start_date") @db.Date
  endDate     DateTime?    @map("end_date") @db.Date
  status      CourseStatus @default(PLANNED)
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")

  participants CourseParticipant[]

  @@index([status])
  @@map("training_courses")
}

model CourseParticipant {
  id        String   @id @default(cuid())
  courseId  String   @map("course_id")
  fullName  String   @map("full_name")
  phone     String?
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  course TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@map("course_participants")
}

// Written volunteer contracts mandated by law 06-18 (contractual volunteering,
// in force since 5 Aug 2021): identity, mission, weekly hours, duration and
// insurance must all appear on the signed contract.
model VolunteerContract {
  id             String         @id @default(cuid())
  memberId       String?        @map("member_id")
  volunteerName  String         @map("volunteer_name")
  cin            String?
  phone          String?
  birthDate      DateTime?      @map("birth_date") @db.Date
  address        String?
  missionTitle   String         @map("mission_title")
  missionDetails String?        @map("mission_details")
  weeklyHours    Decimal?       @map("weekly_hours") @db.Decimal(4, 1)
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime?      @map("end_date") @db.Date
  insuranceRef   String?        @map("insurance_ref")
  status         ContractStatus @default(DRAFT)
  signedAt       DateTime?      @map("signed_at") @db.Date
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("volunteer_contracts")
}

// Employees & monthly payroll — associations that hire staff must track
// CNSS-numbered contracts, gross/net salaries and monthly payment status.
model Employee {
  id             String               @id @default(cuid())
  fullName       String               @map("full_name")
  cin            String?
  cnssNumber     String?              @map("cnss_number")
  position       String
  contractType   EmployeeContractType @default(CDI) @map("contract_type")
  status         EmployeeStatus       @default(ACTIVE)
  hireDate       DateTime             @map("hire_date") @db.Date
  endDate        DateTime?            @map("end_date") @db.Date
  grossSalary    Decimal?             @map("gross_salary") @db.Decimal(10, 2)
  bankName       String?              @map("bank_name")
  bankRib        String?              @map("bank_rib")
  phone          String?
  email          String?
  address        String?
  contractDocUrl String?              @map("contract_doc_url")
  notes          String?
  createdAt      DateTime             @default(now()) @map("created_at")

  payrolls PayrollRun[]

  @@index([status])
  @@map("employees")
}

model PayrollRun {
  id          String        @id @default(cuid())
  employeeId  String        @map("employee_id")
  period      String // YYYY-MM, e.g. "2026-08"
  grossAmount Decimal       @map("gross_amount") @db.Decimal(10, 2)
  cnssAmount  Decimal?      @map("cnss_amount") @db.Decimal(10, 2)
  netAmount   Decimal       @map("net_amount") @db.Decimal(10, 2)
  paidAt      DateTime?     @map("paid_at") @db.Date
  status      PayrollStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@index([period])
  @@map("payroll_runs")
}

// Non-financial partnership agreements (Grants already cover funded
// partnerships); track school/clinic/commune/NGO conventions and CSR
// partnerships with auto-expiry tracking.
model Partnership {
  id           String            @id @default(cuid())
  partnerName  String            @map("partner_name")
  kind         PartnershipKind   @default(OTHER)
  contactName  String?           @map("contact_name")
  contactPhone String?           @map("contact_phone")
  contactEmail String?           @map("contact_email")
  object       String // موضوع الاتفاقية
  signedAt     DateTime?         @map("signed_at") @db.Date
  startDate    DateTime?         @map("start_date") @db.Date
  endDate      DateTime?         @map("end_date") @db.Date
  status       PartnershipStatus @default(DRAFT)
  fileUrl      String?           @map("file_url")
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")

  @@index([status])
  @@index([endDate])
  @@map("partnerships")
}

// Library catalog (quran schools, cultural & literacy associations lend books
// to members and students). Physical copies tracked separately so multiple
// copies of the same title can be lent independently.
model LibraryBook {
  id          String       @id @default(cuid())
  title       String
  author      String?
  category    BookCategory @default(OTHER)
  isbn        String?
  copiesTotal Int          @default(1) @map("copies_total")
  shelf       String? // reference / location
  acquiredAt  DateTime?    @map("acquired_at") @db.Date
  notes       String?
  createdAt   DateTime     @default(now()) @map("created_at")

  borrowings BookBorrowing[]

  @@index([category])
  @@map("library_books")
}

model BookBorrowing {
  id           String          @id @default(cuid())
  bookId       String          @map("book_id")
  borrowerName String          @map("borrower_name")
  memberId     String?         @map("member_id")
  borrowedAt   DateTime        @map("borrowed_at") @db.Date
  dueAt        DateTime        @map("due_at") @db.Date
  returnedAt   DateTime?       @map("returned_at") @db.Date
  status       BorrowingStatus @default(OPEN)
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")

  book   LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  member Member?     @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([bookId])
  @@index([status])
  @@map("book_borrowings")
}
